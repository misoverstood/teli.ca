---
import '../styles/global.css';
import { toJsonLd } from '../data/schema';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  jsonLd?: unknown;
}

const { title, description, noindex = false, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const ogAlt = "teli.ca: Tech, sorted. The IT person you don't have.";
const fullTitle = `${title} | teli.ca`;
const year = new Date().getFullYear();
const cfBeacon = JSON.stringify({ token: site.cfAnalyticsToken });

// Content Security Policy, production builds only (the dev server injects its own scripts).
// Allows: our own files, Cloudflare Turnstile, Cloudflare Web Analytics, and form posts to the Worker.
const formOrigin = new URL(site.contactEndpoint).origin;
const csp = [
  "default-src 'self'",
  "script-src 'self' https://challenges.cloudflare.com https://static.cloudflareinsights.com",
  "connect-src 'self' https://cloudflareinsights.com",
  "frame-src https://challenges.cloudflare.com",
  "img-src 'self' data:",
  "font-src 'self'",
  "style-src 'self'",
  `form-action 'self' ${formOrigin}`,
  "base-uri 'self'",
  "object-src 'none'",
].join('; ');
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="teli.ca" />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    {jsonLd && <script type="application/ld+json" set:html={toJsonLd(jsonLd)} />}
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
    >
      Skip to content
    </a>

    <header class="container-site flex items-center justify-between gap-4 py-6">
      <a href="/" class="text-wordmark" aria-label="teli.ca home">teli<span class="text-accent">.ca</span></a>

      <nav aria-label="Main" class="flex items-center gap-3 md:gap-8">
        <ul class="hidden items-center gap-8 md:flex">
          <li><a href="/services/" class="font-semibold decoration-2 underline-offset-4 hover:underline hover:decoration-accent">Services</a></li>
          <li><a href="/about/" class="font-semibold decoration-2 underline-offset-4 hover:underline hover:decoration-accent">About</a></li>
        </ul>

        <details class="relative md:hidden">
          <summary class="flex min-h-11 cursor-pointer items-center rounded-full border border-ink px-4 font-semibold">Menu</summary>
          <ul class="absolute right-0 top-full z-40 mt-2 w-48 rounded-panel border border-line bg-paper p-2">
            <li><a href="/services/" class="block rounded-input px-3 py-2 font-semibold hover:bg-mist">Services</a></li>
            <li><a href="/about/" class="block rounded-input px-3 py-2 font-semibold hover:bg-mist">About</a></li>
          </ul>
        </details>

        <a
          href="/contact/"
          class="inline-flex min-h-11 items-center rounded-full bg-ink px-4 font-semibold text-paper transition-opacity duration-150 ease-out hover:opacity-85 md:px-5"
        >
          Get in touch
        </a>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="border-t border-line">
      <div class="container-site flex flex-col gap-6 py-10 text-small text-muted md:flex-row md:items-center md:justify-between">
        <a href="/" class="text-lead font-extrabold text-ink" aria-label="teli.ca home">teli<span class="text-accent">.ca</span></a>
        <nav aria-label="Footer">
          <ul class="flex flex-wrap gap-x-6 gap-y-2">
            <li><a href="/services/" class="decoration-2 underline-offset-4 hover:underline hover:decoration-accent">Services</a></li>
            <li><a href="/about/" class="decoration-2 underline-offset-4 hover:underline hover:decoration-accent">About</a></li>
            <li><a href="/contact/" class="decoration-2 underline-offset-4 hover:underline hover:decoration-accent">Contact</a></li>
            <li><a href="/privacy/" class="decoration-2 underline-offset-4 hover:underline hover:decoration-accent">Privacy</a></li>
          </ul>
        </nav>
        <p>&copy; {year} teli.ca</p>
      </div>
    </footer>

    {import.meta.env.PROD && (
      <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={cfBeacon}></script>
    )}
  </body>
</html>

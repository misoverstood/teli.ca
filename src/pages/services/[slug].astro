---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import { services, howItWorks, type Service } from '../../data/services';
import { serviceSchemas } from '../../data/schema';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<BaseLayout title={service.title} description={service.description} jsonLd={serviceSchemas(service)}>
  <section class="container-site pt-12 md:pt-20">
    <h1 class="text-h1">{service.name}</h1>
    <p class="mt-6 max-w-prose text-lead text-muted">{service.lead}</p>
  </section>

  <section class="container-site section-y">
    <div aria-labelledby="included-heading">
      <h2 id="included-heading" class="text-h2">What&rsquo;s included</h2>
      <ul class="mt-8 grid gap-x-8 gap-y-4 md:grid-cols-2">
        {
          service.included.map((item) => (
            <li class="flex gap-3">
              <svg viewBox="0 0 24 24" class="mt-1 size-5 shrink-0 text-accent" aria-hidden="true">
                <path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-8"><a href="/services">See all services</a></p>
    </div>

    <div class="mt-20 md:mt-28" aria-labelledby="how-heading">
      <h2 id="how-heading" class="text-h2">How it works</h2>
      <ol class="mt-8 grid gap-8 md:grid-cols-2 lg:grid-cols-4">
        {
          howItWorks.map((step, i) => (
            <li class="border-t border-line pt-6">
              <p class="text-lead font-extrabold text-hero-gray">{i + 1}</p>
              <h3 class="mt-2 text-h3">{step.title}</h3>
              <p class="mt-2 text-muted">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="on-mist bg-mist" aria-labelledby="faq-heading">
    <div class="container-site section-y">
      <h2 id="faq-heading" class="text-h2">Questions</h2>
      <div class="mt-8 border-t border-line">
        {
          service.faqs.map((faq) => (
            <div class="grid gap-2 border-b border-line py-6 md:grid-cols-3 md:gap-8 md:py-8">
              <h3 class="text-h3">{faq.q}</h3>
              <p class="max-w-prose text-muted md:col-span-2">{faq.a}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

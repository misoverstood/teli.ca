---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceRows from '../../components/ServiceRows.astro';
import CtaBand from '../../components/CtaBand.astro';
import { businessServices, personalServices } from '../../data/services';
---

<BaseLayout
  title="IT services in Toronto and the GTA"
  description="Email, domains, security, migrations, websites, SEO, automation and workplace IT for businesses and organizations, plus home networks, personal security, device care and online privacy across the GTA."
>
  <section class="container-site pt-12 md:pt-20">
    <h1 class="text-h1">Services</h1>
    <p class="mt-6 max-w-prose text-lead text-muted">
      IT services for businesses, organizations and households across the GTA, from a single fix to a full setup. Not sure which fits? Get in touch and tell me what you have in mind.
    </p>
    <p class="mt-4 max-w-prose text-muted">
      Who I work with: small and home-based businesses, nonprofits, places of worship and community organizations, professionals working from home, and individuals and families.
    </p>
  </section>

  <section class="container-site section-y" aria-labelledby="business-heading">
    <h2 id="business-heading" class="text-h2">For businesses and organizations</h2>
    <p class="mt-3 max-w-prose text-lead text-muted">Technology that runs reliably and securely, so you can focus on the work.</p>
    <div class="mt-10">
      <ServiceRows items={businessServices} />
    </div>
  </section>

  <section class="on-mist bg-mist" aria-labelledby="personal-heading">
    <div class="container-site section-y">
      <h2 id="personal-heading" class="text-h2">For homes and families</h2>
      <p class="mt-3 max-w-prose text-lead text-muted">Devices, networks and accounts that work the way they should, and stay secure.</p>
      <div class="mt-10">
        <ServiceRows items={personalServices} />
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

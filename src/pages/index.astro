---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceRows from '../components/ServiceRows.astro';
import { businessServices, personalServices } from '../data/services';
---

<BaseLayout
  title="IT help for homes and small businesses in Toronto"
  description="Independent IT help in Toronto for small businesses, nonprofits, home offices and households: email, domains, networks, security and online clean-up."
>
  <section class="container-site pt-12 md:pt-20">
    <h1>
      <span class="block text-display">Tech, sorted.</span>
      <span class="mt-3 block text-display-sub text-hero-gray">The IT person you don&rsquo;t have.</span>
    </h1>
    <p class="mt-8 max-w-prose text-lead text-muted">
      Setup, security and clean-up for your devices, accounts and networks, at home or at work. One experienced person to deal with, start to finish.
    </p>
    <div class="mt-10 flex flex-wrap gap-4">
      <a
        href="/contact"
        class="inline-flex min-h-11 items-center rounded-full bg-ink px-6 font-semibold text-paper transition-opacity duration-150 ease-out hover:opacity-85"
      >
        Get in touch
      </a>
      <a
        href="/services"
        class="inline-flex min-h-11 items-center rounded-full border border-ink px-6 font-semibold text-ink transition-colors duration-150 ease-out hover:bg-mist"
      >
        See services
      </a>
    </div>
  </section>

  <section class="container-site section-y" aria-labelledby="business-heading">
    <h2 id="business-heading" class="text-h2">For your business</h2>
    <p class="mt-3 max-w-prose text-lead text-muted">Small teams, nonprofits and anyone working from home.</p>
    <div class="mt-10">
      <ServiceRows items={businessServices} />
    </div>
  </section>

  <section class="bg-ink text-paper" aria-label="How I work">
    <div class="container-site section-y">
      <p class="max-w-4xl text-statement">
        Set up properly, explained in plain language, and written down so you&rsquo;re never stuck.
      </p>
    </div>
  </section>

  <section class="on-mist bg-mist" aria-labelledby="personal-heading">
    <div class="container-site section-y">
      <h2 id="personal-heading" class="text-h2">For you and your home</h2>
      <p class="mt-3 max-w-prose text-lead text-muted">Your own devices, accounts and Wi-Fi.</p>
      <div class="mt-10">
        <ServiceRows items={personalServices} />
      </div>
    </div>
  </section>

  <section class="container-site section-y" aria-label="Where to start">
    <div class="grid gap-4 md:grid-cols-2">
      <div class="on-mist flex flex-col items-start rounded-panel bg-mist p-8 md:p-10">
        <h2 class="text-h3">Running a business or nonprofit?</h2>
        <p class="mt-3 text-muted">Tell me what&rsquo;s slowing you down and I&rsquo;ll suggest where to start.</p>
        <a
          href="/contact?type=business"
          class="mt-8 inline-flex min-h-11 items-center rounded-full bg-ink px-6 font-semibold text-paper transition-opacity duration-150 ease-out hover:opacity-85"
        >
          Start a business inquiry
        </a>
      </div>
      <div class="flex flex-col items-start rounded-panel bg-ink p-8 text-paper md:p-10">
        <h2 class="text-h3">Sorting things out at home?</h2>
        <p class="mt-3 text-muted-on-ink">Wi-Fi, passwords, a hacked account or your details online. Tell me what&rsquo;s going on.</p>
        <a
          href="/contact?type=personal"
          class="mt-8 inline-flex min-h-11 items-center rounded-full bg-paper px-6 font-semibold text-ink transition-opacity duration-150 ease-out hover:opacity-85"
        >
          Start a personal inquiry
        </a>
      </div>
    </div>
  </section>

  <section class="bg-ink text-paper" aria-labelledby="cta-heading">
    <div class="container-site section-y flex flex-col items-start gap-8 md:flex-row md:items-center md:justify-between">
      <h2 id="cta-heading" class="text-h2">Got something that needs sorting?</h2>
      <a
        href="/contact"
        class="inline-flex min-h-11 shrink-0 items-center rounded-full bg-paper px-6 font-semibold text-ink transition-opacity duration-150 ease-out hover:opacity-85"
      >
        Get in touch
      </a>
    </div>
  </section>
</BaseLayout>

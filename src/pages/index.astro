---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Testimonials from '../components/Testimonials.astro';
import { businessSchema } from '../data/schema';

const areas = [
  { title: 'Email, domains and the cloud', line: 'Email and collaboration tools, domains and DNS, and moves between platforms.' },
  { title: 'Security and privacy', line: 'Strong authentication, managed devices, and your personal information protected.' },
  { title: 'Networks, devices and workplaces', line: 'Reliable, secure networks and devices, at work and at home.' },
  { title: 'Websites, search and automation', line: 'Websites people can find, and repetitive work handed to automation and AI.' },
];
---

<BaseLayout
  title="IT consulting and support in Toronto and the GTA"
  description="IT consulting and hands-on support for businesses, organizations and households across the GTA: email, domains, security, networks, websites, SEO and automation."
  jsonLd={businessSchema()}
>
  <section class="container-site pt-12 md:pt-20">
    <h1>
      <span class="block text-display">Tech, sorted.</span>
      <span class="mt-3 block text-display-sub text-hero-gray">The IT person you don&rsquo;t have.</span>
    </h1>
    <p class="mt-8 max-w-prose text-lead text-muted">
      IT consulting and hands-on support for businesses, organizations and households across the GTA. One experienced person, from first conversation to finished work.
    </p>
    <div class="mt-10 flex flex-wrap gap-4">
      <a
        href="/contact/"
        class="inline-flex min-h-11 items-center rounded-full bg-ink px-6 font-semibold text-paper transition-opacity duration-150 ease-out hover:opacity-85"
      >
        Get in touch
      </a>
      <a
        href="/services/"
        class="inline-flex min-h-11 items-center rounded-full border border-ink px-6 font-semibold text-ink transition-colors duration-150 ease-out hover:bg-mist"
      >
        See services
      </a>
    </div>
  </section>

  <section class="container-site section-y" aria-labelledby="areas-heading">
    <h2 id="areas-heading" class="text-h2">What I do</h2>
    <p class="mt-3 max-w-prose text-lead text-muted">For businesses, organizations and households across the GTA.</p>
    <ul class="mt-10 border-t border-line">
      {
        areas.map((a) => (
          <li class="border-b border-line">
            <a href="/services/" class="group grid gap-2 py-6 md:grid-cols-3 md:items-baseline md:gap-8 md:py-8">
              <span class="flex items-baseline gap-3 text-h3">
                <span class="decoration-accent decoration-2 underline-offset-4 group-hover:underline">{a.title}</span>
                <span aria-hidden="true" class="transition-colors duration-150 ease-out group-hover:text-accent">&rarr;</span>
              </span>
              <span class="text-lead text-muted md:col-span-2">{a.line}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="bg-ink text-paper" aria-label="How I work">
    <div class="container-site section-y">
      <p class="max-w-4xl text-statement">
        Your technology, set up properly, explained in plain language and fully documented.
      </p>
    </div>
  </section>

  <section class="on-mist bg-mist" aria-labelledby="how-heading">
    <div class="container-site section-y">
      <h2 id="how-heading" class="text-h2">How it works</h2>
      <HowItWorks />
    </div>
  </section>

  <Testimonials />

  <CtaBand />
</BaseLayout>

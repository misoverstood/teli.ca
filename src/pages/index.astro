---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="IT help for homes and small businesses in Toronto"
  description="Independent IT help in Toronto for small businesses, nonprofits, home offices and households: email, domains, networks, security and online clean-up."
>
  <section class="container-site pt-12 pb-24 md:pt-20 md:pb-40">
    <h1 class="text-display">
      <span class="block">Tech, sorted.</span>
      <span class="block text-hero-gray">The IT person you don&rsquo;t have.</span>
    </h1>
    <p class="mt-8 max-w-prose text-lead text-muted">
      Setup, security and clean-up for your devices, accounts and networks, at home or at work. One experienced person to deal with, start to finish.
    </p>
    <div class="mt-10 flex flex-wrap gap-4">
      <a
        href="/contact"
        class="inline-flex min-h-11 items-center rounded-full bg-ink px-6 font-semibold text-paper transition-opacity duration-150 ease-out hover:opacity-85"
      >
        Get in touch
      </a>
      <a
        href="/services"
        class="inline-flex min-h-11 items-center rounded-full border border-ink px-6 font-semibold text-ink transition-colors duration-150 ease-out hover:bg-mist"
      >
        See services
      </a>
    </div>
  </section>
</BaseLayout>

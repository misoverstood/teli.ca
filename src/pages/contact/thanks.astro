---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Message sent" description="Thanks for getting in touch." noindex>
  <section class="container-site pt-12 pb-24 md:pt-20 md:pb-32">
    <h1 class="text-h1">Thanks, message sent.</h1>
    <p class="mt-6 max-w-prose text-lead text-muted">
      I&rsquo;ll reply by email. If you don&rsquo;t see it within a couple of days, check your junk folder.
    </p>
    <a
      href="/"
      class="mt-10 inline-flex min-h-11 items-center rounded-full border border-ink px-6 font-semibold text-ink transition-colors duration-150 ease-out hover:bg-mist"
    >
      Back to home
    </a>
  </section>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';

const field =
  'mt-2 block w-full rounded-input border border-line bg-paper px-4 text-body text-ink transition-colors duration-150 ease-out hover:border-muted focus:border-ink';

const turnstileKey = import.meta.env.DEV ? site.turnstileTestSiteKey : site.turnstileSiteKey;
---

<BaseLayout
  title="Contact"
  description="Get in touch about IT help for your small business, nonprofit, home office or household in Toronto. Describe what's going on and I'll reply by email."
>
  <section class="container-site pt-12 md:pt-20">
    <h1 class="text-h1">Get in touch</h1>
    <p class="mt-6 max-w-prose text-lead text-muted">
      Tell me what&rsquo;s going on in your own words. No technical detail needed. I&rsquo;ll reply by email.
    </p>
  </section>

  <section class="container-site section-y">
    <div class="grid gap-16 lg:grid-cols-3 lg:gap-12">
      <form method="post" action={site.contactEndpoint} class="max-w-2xl lg:col-span-2">
        <p class="text-small text-muted">All fields are required.</p>

        <div class="mt-6">
          <label for="name" class="block font-semibold">Name</label>
          <input id="name" name="name" type="text" autocomplete="name" required maxlength="100" class={`${field} h-12`} />
        </div>

        <div class="mt-6">
          <label for="email" class="block font-semibold">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required maxlength="254" class={`${field} h-12`} />
        </div>

        <div class="mt-6">
          <label for="message" class="block font-semibold">What&rsquo;s going on?</label>
          <textarea id="message" name="message" required maxlength="5000" rows="8" class={`${field} min-h-48 py-3`}></textarea>
        </div>

        <div aria-hidden="true" class="absolute left-[-9999px] top-auto h-px w-px overflow-hidden">
          <label for="website">Leave this field empty</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="cf-turnstile mt-6" data-sitekey={turnstileKey} data-theme="light" data-size="flexible"></div>

        <p class="mt-6 text-small text-muted">
          Your details are only used to reply to you. Read the <a href="/privacy/">privacy policy</a>.
        </p>

        <button
          type="submit"
          class="mt-8 inline-flex min-h-11 cursor-pointer items-center rounded-full bg-ink px-6 font-semibold text-paper transition-opacity duration-150 ease-out hover:opacity-85"
        >
          Send message
        </button>
      </form>

      <aside class="space-y-10">
        <div>
          <h2 class="text-h3">Not sure what you need?</h2>
          <p class="mt-3 text-muted">
            That&rsquo;s fine. Describe the problem or what you&rsquo;d like to change, and we&rsquo;ll work out the right starting point together.
          </p>
        </div>
        <div>
          <h2 class="text-h3">Keep it safe</h2>
          <p class="mt-3 text-muted">
            Please don&rsquo;t include passwords, account numbers or other sensitive details. If they&rsquo;re ever needed, we&rsquo;ll handle them a safer way.
          </p>
        </div>
      </aside>
    </div>
  </section>

  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</BaseLayout>

---
import { howItWorks } from '../data/services';
---

<ol class="mt-8 grid gap-8 md:grid-cols-2 lg:grid-cols-4">
  {
    howItWorks.map((step, i) => (
      <li class="border-t border-line pt-6">
        <p class="text-lead font-extrabold text-hero-gray">{i + 1}</p>
        <h3 class="mt-2 text-h3">{step.title}</h3>
        <p class="mt-2 text-muted">{step.body}</p>
      </li>
    ))
  }
</ol>

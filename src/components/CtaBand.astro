---
interface Props {
  heading?: string;
}

const { heading = "Got something that needs sorting?" } = Astro.props;
---

<section class="bg-ink text-paper" aria-labelledby="cta-heading">
  <div class="container-site section-y flex flex-col items-start gap-8 md:flex-row md:items-center md:justify-between">
    <h2 id="cta-heading" class="text-h2">{heading}</h2>
    <a
      href="/contact/"
      class="inline-flex min-h-11 shrink-0 items-center rounded-full bg-paper px-6 font-semibold text-ink transition-opacity duration-150 ease-out hover:opacity-85"
    >
      Get in touch
    </a>
  </div>
</section>
